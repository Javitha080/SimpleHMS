root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

[*.html]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
